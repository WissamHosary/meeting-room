# Copy this file to .env and fill in what you want. Everything is optional.
PORT=3000

# --- AI brain (pick one; with none, the free built-in "office brain" runs) ---
# FREE: Google Gemini key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# FREE: Groq key from https://console.groq.com/keys
GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile

# FREE but runs on your PC (slow on 8GB RAM): install Ollama, then e.g. OLLAMA_MODEL=qwen2.5:3b
OLLAMA_MODEL=

# PAID later: Claude (best quality)
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-sonnet-5-5

# Force a provider instead of auto: gemini | groq | ollama | claude | offline
# AI_PROVIDER=auto

# Liwaa's default news topics
# TREND_TOPICS=Lebanon business OR AI apps OR social media marketing OR restaurant loyalty
